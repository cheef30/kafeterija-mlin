      'M152 47 C156 44 168 44 172 47',
      'M46 226 L46 236 M154 226 L154 236',
      'M54 150 L146 150',
      'M28 52 C28 40 46 40 46 52 C46 64 28 64 28 52 Z M33 46 C40 50 34 56 41 59',
      'M58 24 C58 14 74 14 74 24 C74 34 58 34 58 24 Z M62 19 C68 22 63 27 69 30',
      'M22 92 C22 84 34 84 34 92 C34 100 22 100 22 92 Z',
    ],
  },
  // Šolja sa parom i slovom M
  solja: {
    vb: '0 0 200 200',
    paths: [
      'M48 92 L142 92 L142 120 C142 150 122 166 95 166 C68 166 48 150 48 120 Z',
      'M142 104 C166 102 168 136 142 138',
      'M28 174 C60 186 130 186 162 174',
      'M78 143 L78 117 L95 134 L112 117 L112 143',
      'M76 80 C68 68 86 60 78 46 C72 36 82 28 80 18',
