---
// Kredne ilustracije u stilu izloga na Voždovcu. Crtaju se kad uđu u ekran.
// Na celom sajtu ih ima četiri: mlin (pržionica), šolja (kafe), bicikl-para (bike), zrno (404).
interface Props { kind: 'mlin' | 'solja' | 'zrno' | 'para'; class?: string; }
const { kind, class: cls = '' } = Astro.props;

const art: Record<string, { vb: string; paths: string[] }> = {
  // Ručni mlin sa kutijom i fiokom, kao na izlogu
