const a = art[kind];
---
<svg class={`chalk ${cls}`} viewBox={a.vb} aria-hidden="true" focusable="false" data-chalk>
  <g class="chalk__lines">
    {a.paths.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
  </g>
</svg>
