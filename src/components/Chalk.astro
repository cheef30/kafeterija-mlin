  },
  // Para iznad šolje, za Espresso Bike
  para: {
    vb: '0 0 120 160',
    paths: [
      'M18 112 L102 112 L102 128 C102 146 86 154 60 154 C34 154 18 146 18 128 Z',
      'M102 118 C118 118 118 136 102 138',
